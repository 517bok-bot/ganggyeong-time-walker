# ── 서버 전용 (절대 NEXT_PUBLIC_ 접두사를 붙이지 마세요) ──
# QR 서명 비밀키: 긴 임의 문자열. 바꾸면 이미 인쇄한 QR이 모두 무효가 됩니다.
QR_SECRET=change-me-to-a-long-random-string
# Supabase Service Role 키 (대시보드 → Project Settings → API). 서버에서만 사용
SUPABASE_SERVICE_ROLE_KEY=
# 관리자 이메일 (쉼표로 구분). profiles.role='admin' 으로도 지정 가능
ADMIN_EMAILS=
# true 로 두면 서버 모드에서도 '현장 도착 시뮬레이션'·'숙성 빨리감기'를 허용 (스테이징 전용, 운영에서는 비워 두세요)
DEMO_TOOLS=

# ── 공개 값 (브라우저에 노출되어도 되는 값) ──
# 두 값을 모두 넣으면 로그인·서버 저장 모드가 켜지고, 비워 두면 로컬 모드로 동작합니다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── 5단계: AI NPC (서버 전용) ──
ANTHROPIC_API_KEY=
